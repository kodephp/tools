{
    "name": "kode/tools",
    "version": "2.1.0",
    "description": "PHP8.4+通用工具包，包含消息体、数组处理、字符串处理、时间处理、加解密、IP、地理计算、Curl、二维码、全局辅助函数等",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "php8",
        "array",
        "string",
        "time",
        "message",
        "crypto",
        "tree",
        "ip",
        "geo",
        "helper",
        "curl",
        "qrcode",
        "tools",
        "pipe",
        "pipeline"
    ],
    "homepage": "https://github.com/kodephp/tools",
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kodephp/tools/issues",
        "source": "https://github.com/kodephp/tools",
        "docs": "https://github.com/kodephp/tools/blob/master/README.md"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/kode"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "endroid/qr-code": "^6.1"
    },
    "suggest": {
        "ext-apcu": "APCu 扩展 - 用于 ApcuStorage 限流存储"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.20",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Kode\\": "src/"
        },
        "files": [
            "src/Helper/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
